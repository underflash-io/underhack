# Underhack environment configuration
# Copy this to .env and fill in the values.

# ============================================================
# REQUIRED
# ============================================================

# First admin user. Created on first boot. Change the password
# immediately by signing in and visiting /settings.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# LLM gateway used for triage. Underhack expects an OpenAI-compatible
# API. Requesty is the default; you can point this at any provider that
# speaks the OpenAI Chat Completions protocol (OpenAI, OpenRouter,
# Together, Ollama with the openai shim, etc).
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
LLM_MODEL=openai/gpt-4o-mini

# ============================================================
# OPTIONAL
# ============================================================

# Where the SQLite database lives. Make sure this is on persistent
# storage if you're running in a container.
DB_PATH=./data/underhack.db

# How often the worker polls sources (seconds). Default is 5 minutes.
POLL_INTERVAL_SEC=300

# Default minimum severity for global notification fallbacks.
# One of: low | med | high | critical
SEVERITY_THRESHOLD=high

# Used for absolute URLs in emails and OAuth redirects.
BASE_URL=http://localhost:4317

# ============================================================
# NOTIFICATIONS (optional global fallbacks)
# ============================================================
# Per-system connectors configured in the UI take precedence.

# Slack incoming webhook URL
SLACK_WEBHOOK=

# Generic JSON webhook (POST {alert: {...}})
ALERT_WEBHOOK=

# ============================================================
# OAUTH (optional)
# ============================================================
# Leave blank to disable a provider button on the login page.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# ============================================================
# DEPLOYMENT
# ============================================================
NODE_ENV=production
